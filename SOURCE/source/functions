# require_binary NAME VAR
#
# Locate NAME in PATH and store its absolute path in the variable named VAR.
# SBU's external tools are hard dependencies: if one is missing there is
# nothing useful the utility can do, so fail loudly at load time rather than
# at the first use with a confusing "no such file or directory".
function require_binary {
	local name="$1" var="$2" path
	path=$(command -v "$name" 2>/dev/null) || {
		echo "ERROR: $name not found in PATH. Install $name and try again." >&2
		exit 1
	}
	printf -v "$var" '%s' "$path"
}

require_binary rsync RSYNC_BIN

# load_job_config JOB
#
# Read JOB's config file and populate, from the job's config file:
#   NAME SOURCE DEST INTERVAL RETENTION AUTOSTART FULLSYNC
#   SETPERMS SETOWNER SETGROUP EXCLUDEFILE
# A key is matched only at the start of a line, and the value is everything
# after the first "=", so values may themselves contain "=" (symbolic chmod
# specs and paths, for example).
# Returns 1 if the config file does not exist.
function load_job_config {
	local conf="/opt/sbu/jobs/$1/$1.conf" line

	[ -e "$conf" ] || return 1

	while read -r line
	do
		case "$line" in
			\#*)           continue ;;
			Name=*)        NAME="${line#*=}" ;;
			Source=*)      SOURCE="${line#*=}" ;;
			Dest=*)        DEST="${line#*=}" ;;
			Interval=*)    INTERVAL="${line#*=}" ;;
			Retention=*)   RETENTION="${line#*=}" ;;
			Autostart=*)   AUTOSTART="${line#*=}" ;;
			FullSync=*)    FULLSYNC="${line#*=}" ;;
			DestPerms=*)   SETPERMS="${line#*=}" ;;
			DestOwner=*)   SETOWNER="${line#*=}" ;;
			DestGroup=*)   SETGROUP="${line#*=}" ;;
			ExcludeFile=*) EXCLUDEFILE="${line#*=}" ;;
		esac
	done < "$conf"
}

# set_config_value FILE KEY VALUE
#
# Replace KEY's value in FILE, matching the key only at the start of a line.
# The file is rewritten to a temporary file in the same directory and moved
# into place, so an interrupted edit cannot leave a truncated config behind.
# VALUE is passed through the environment rather than awk -v so that it is
# treated as a literal string, not as a regex or an escape sequence.
# Returns 1 if the file is missing or the rewrite fails.
function set_config_value {
	local file="$1" key="$2" value="$3" tmpfile

	[ -e "$file" ] || return 1

	tmpfile=$(mktemp "${file}.XXXXXX") || return 1

	SBU_CFG_VALUE="$value" awk -v key="$key" '
		BEGIN { value = ENVIRON["SBU_CFG_VALUE"] }
		index($0, key "=") == 1 { print key "=" value; next }
		{ print }
	' "$file" > "$tmpfile" || { rm -f "$tmpfile"; return 1; }

	chmod --reference="$file" "$tmpfile" 2>/dev/null
	mv "$tmpfile" "$file"
}

function checkStatus {
	
	NAME=$1
	STATUS=0
	
	load_job_config "$NAME"
	
	PID1=$(pgrep -f "/opt/sbu/source/create-new-job.sh ${SOURCE}")
	PID2=$(pgrep -f "/opt/sbu/source/run-job.sh $NAME")

	if [[ -n "$PID1" || -n "$PID2" ]]; then
		STATUS=1
	else
		STATUS=0
	fi
	
	echo $STATUS
	
}

function getCurrentStatus {
	
	NAME=$1
	TOTALSTATUS=""
	
	load_job_config "$NAME" || echo "Could not get $NAME config!"
	
	PID1=$(pgrep -f "/opt/sbu/source/create-new-job.sh ${SOURCE}")
	PID2=$(pgrep -f "/opt/sbu/source/run-job.sh $NAME")
		
	if [[ -n "$PID1" || -n "$PID2" ]]; then
		
		STATUS="- idle"
		
		if [[ -e "/opt/sbu/jobs/$NAME/$NAME-rolling-up-backup" ]]; then
			STATUS1="rolling up backup"
		fi
		
		if [[ -e "/opt/sbu/jobs/$NAME/$NAME-initializing" ]]; then
			STATUS3="initializing"
		fi
	
		if [[ -e "/opt/sbu/jobs/$NAME/$NAME-currently-taking-snapshot" ]]; then
			STATUS4="currently taking snapshot"
		fi
	
		if [[ -e "/opt/sbu/jobs/$NAME/$NAME-searching" ]]; then
			STATUS5="searching for changes"
		fi
	
		if [[ -e "/opt/sbu/jobs/$NAME/$NAME-syncing-changes" ]]; then
			STATUS6="syncing changes"
		fi
		
	else
		STATUS="is not running!"
	fi
	
	if [[ ! -z "$STATUS1" ]]; then
		TOTALSTATUS=$TOTALSTATUS" - "$STATUS1
	fi
	
	if [[ ! -z "$STATUS3" ]]; then
		TOTALSTATUS=$TOTALSTATUS" - "$STATUS3
	fi
	
	if [[ ! -z "$STATUS4" ]]; then
		TOTALSTATUS=$TOTALSTATUS" - "$STATUS4
	fi
	
	if [[ ! -z "$STATUS5" ]]; then
		TOTALSTATUS=$TOTALSTATUS" - "$STATUS5
	fi
	
	if [[ ! -z "$STATUS6" ]]; then
		TOTALSTATUS=$TOTALSTATUS" - "$STATUS6
	fi
	
	if [[ ! -z "$TOTALSTATUS" ]]; then
		echo $NAME $TOTALSTATUS
	else
		echo $NAME $STATUS
	fi
	
}

function usage {	
	clear
	if command -v less >/dev/null 2>&1; then
		less /opt/sbu/docs/usage.txt
	else
		cat /opt/sbu/docs/usage.txt
	fi
}
